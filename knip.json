{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.ts",
    "src/web.ts",
    "scripts/**/*.ts",
    "src/__tests__/**/*.test.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts"],
  "ignore": [
    "web/**",
    "tests/**"
  ],
  "ignoreDependencies": [
    "tsx",
    "@playwright/test"
  ]
}
