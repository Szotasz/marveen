{
  "name": "marveen",
  "version": "1.44.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/write-built-commit.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "hook-failures": "tsx scripts/hook-failures.ts",
    "remote-enroll": "tsx scripts/remote-access-enroll.ts",
    "bridge-device-key": "tsx scripts/bridge-device-key.ts",
    "dashboard-user": "tsx scripts/dashboard-user.ts",
    "test": "vitest run",
    "test:codex-node": "node --test scripts/__tests__/codex-channel-fixture.test.mjs scripts/__tests__/codex-delivery-lifecycle.test.mjs scripts/__tests__/codex-thread-rotation.test.mjs",
    "test:codex-channel-import": "npm run build && node scripts/codex-channels.mjs --offline-import-smoke",
    "typecheck": "tsc --noEmit",
    "syntax-check": "node --check web/app.js web/sw.js",
    "smoke": "playwright test --config=playwright.config.ts",
    "skill": "tsx scripts/skill.ts",
    "browser-verify": "playwright test --config=playwright.browser.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.116",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "parse5": "8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
