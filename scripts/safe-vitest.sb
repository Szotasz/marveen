;; Write-restricting sandbox profile for scripts/safe-vitest.sh (macOS sandbox-exec).
;; Everything is allowed except file writes; file writes are re-allowed only for the
;; worktree, the runner's own per-run temp dir and /dev. There is deliberately no blanket
;; /private/tmp or /private/var/folders allowance: the live tmux socket lives in
;; /private/tmp/tmux-<uid> and the user's cache/state live under /private/var/folders.
;; Network is NOT denied: tests listen on loopback, and denying it broke the beforeAll
;; of a test (card 183347ee).
;; Parameters (sandbox-exec -D): WT = realpath of the worktree root,
;; RUN = realpath of the per-run temp dir created by safe-vitest.sh (also its TMPDIR).
(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (subpath (param "WT"))
  (subpath (param "RUN"))
  (subpath "/dev"))
