#!/bin/sh
# @@GENERATED_NOTE@@
#
# Marveen support access: the LAUNCHER (SUPPORTMENTOUT1114). The customer runs
#   ~/@@SUPPORT_DIR@@/@@KIT_DIR@@/@@LAUNCHER@@ [enable | disable]
# when the Marveen service is down and support needs to get in. With no
# argument it only LOOKS: it writes nothing and asks for no code.
#
# What it guarantees (plan v1.5, 3.2-3.5; Samu 32015, 32025, 32050; Dani 32034, 32045):
# - It reads the kit's manifest ONCE, at the start, into memory, and decides
#   from that one read: which node, which install root, and the hash the
#   routine's bytes must have. A manifest that is not exactly the one canonical
#   text is refused (the same rule as the routine's reader; a shared case file
#   tests both).
# - It runs ONLY the kit's copy of the routine, through the loader below: node
#   reads the file once, measures those bytes against the manifest's hash and
#   runs those bytes. The loader text is fixed (generated from
#   KIT_LOADER_SOURCE, word for word); everything that varies goes after `--`.
#   The node is started with env -i and two keys only: no NODE_OPTIONS, no
#   NODE_PATH, nothing of the caller's environment.
# - `disable` runs the INSTALL TREE's routine, whatever the kit's hash says
#   (closing must not depend on the kit; N14/a).
# - The owner's one-time code goes to the routine on standard input, never in
#   an argument and never into typed text.
# - Every read and every run is checked; a failure stops it. Exit 0 with no
#   output is a failure (the routine always answers).

# The caller's PATH is kept for ONE use: the last place to look for a node (3.2, N19).
CALLER_PATH=${PATH:-}
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
LC_ALL=C
export LC_ALL
umask 077

stop() {
  printf '%s\n' "$1" >&2
  printf '%s\n' "A kódot most még ne írd be. Küldd el nekünk, amit a parancs kiírt, és megmondjuk a következő lépést." >&2
  exit "${2:-1}"
}

MODE=
case "$#" in
  0) MODE=status ;;
  1)
    case "$1" in
      enable) MODE=enable ;;
      disable) MODE=disable ;;
    esac
    ;;
esac
[ -n "$MODE" ] || { printf '%s\n' "Használat: @@LAUNCHER@@ [enable | disable]" >&2; exit 2; }

# --- the login user's home, from the user database (no variable moves it) ---
ME=$(id -un 2>/dev/null) || stop "Nem tudom megállapítani, melyik felhasználóval futsz."
case "$(uname -s 2>/dev/null)" in
  Darwin) HOMEDIR=$(dscl . -read "/Users/$ME" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: //p') ;;
  *) HOMEDIR=$(getent passwd "$ME" 2>/dev/null | cut -d: -f6) ;;
esac
case "$HOMEDIR" in
  /*) ;;
  *) stop "Ennél a felhasználónál nem találok Marveent. Azzal a felhasználóval futtasd, amelyik alatt fut." ;;
esac
case "$HOMEDIR" in
  *[!A-Za-z0-9._/-]*) stop "A felhasználó mappájának útja szokatlan karaktert tartalmaz; a mentő-út itt nem használható (kit_input_invalid)." ;;
esac

SUPPORT="$HOMEDIR/@@SUPPORT_DIR@@"
KIT="$SUPPORT/@@KIT_DIR@@"
MANIFEST="$KIT/@@MANIFEST@@"

# --- K6: the two folders are real folders of this user (the routine checks more, below) ---
for d in "$SUPPORT" "$KIT"; do
  if [ -L "$d" ]; then stop "A support-készlet mappája link; így nem futtatom (kit_link)."; fi
  if [ ! -d "$d" ]; then stop "Ez a telepítés régebbi, mint a support-készenlét, vagy a készlet hiányzik (kit_missing). Frissítsd a Marveent, utána futtasd újra ezt a sort."; fi
  if [ ! -O "$d" ]; then stop "A support-készlet mappája nem a te felhasználódé; így nem futtatom (kit_foreign_owner)."; fi
done

# --- the manifest, read ONCE ---
if [ -L "$MANIFEST" ] || [ ! -f "$MANIFEST" ]; then
  stop "A készlet jegyzéke hiányzik vagy nem rendes fájl (kit_manifest_unreadable). Frissítsd a Marveent."
fi
MAN=$(head -c @@MANIFEST_READ_BYTES@@ "$MANIFEST" 2>/dev/null; rc=$?; printf 'x'; exit "$rc") || stop "A készlet jegyzéke nem olvasható (kit_manifest_unreadable)."
MAN=${MAN%x}
[ "${#MAN}" -le @@MANIFEST_MAX_BYTES@@ ] || stop "A készlet jegyzéke nagyobb a megengedettnél (kit_manifest_unreadable)."
CR=$(printf '\r')
case "$MAN" in
  *"$CR"*) stop "A készlet jegyzéke nem a várt alakú (kit_manifest_unreadable)." ;;
esac
case "$MAN" in
  *'
') ;;
  *) stop "A készlet jegyzéke nem a várt alakú (kit_manifest_unreadable)." ;;
esac

# The one canonical text: header; `file <name> <sha256>` lines in name order;
# then install-root, node, node-min, release, each once, in this order.
PARSED=$(printf '%s' "$MAN" | awk -v maxfiles=@@MAX_FILES@@ -v want_l="@@LAUNCHER@@" -v want_d="@@DISPATCHER@@" -v want_r="@@ROUTINE@@" '
function bad() { failed = 1; exit 3 }
function hex(s, n) { return length(s) == n && s ~ /^[0-9a-f]+$/ }
{ line[NR] = $0 }
END {
  if (failed) exit 3
  if (NR < 6 || line[1] != "marveen-support-kit 1") bad()
  i = 2; nfiles = 0; prev = ""
  while (i <= NR && substr(line[i], 1, 5) == "file ") {
    if (split(line[i], p, / /) != 3) bad()
    name = p[2]; h = p[3]
    if (length(name) < 1 || length(name) > 64 || name !~ /^[a-z0-9][a-z0-9._-]*$/ || name == "manifest") bad()
    if (!hex(h, 64)) bad()
    if (nfiles > 0 && !(prev < name)) bad()
    prev = name; nfiles++; files[name] = h; i++
  }
  if (nfiles < 1 || nfiles > maxfiles) bad()
  if (NR != i + 3) bad()
  if (split(line[i], p, / /) != 2 || p[1] != "install-root" || p[2] !~ /^\/[A-Za-z0-9._\/-]+$/) bad()
  root = p[2]
  if (split(line[i + 1], p, / /) != 2 || p[1] != "node" || p[2] !~ /^\/[A-Za-z0-9._@\/-]+$/) bad()
  node = p[2]
  if (split(line[i + 2], p, / /) != 2 || p[1] != "node-min" || p[2] !~ /^[1-9][0-9]*$/ || length(p[2]) > 3) bad()
  nodemin = p[2]
  if (split(line[i + 3], p, / /) != 2 || p[1] != "release" || length(p[2]) < 7 || length(p[2]) > 40 || p[2] !~ /^[0-9a-f]+$/) bad()
  if (!(want_l in files) || !(want_d in files) || !(want_r in files)) exit 4
  print root; print node; print nodemin; print files[want_r]
}') || stop "A készlet jegyzéke nem a várt alakú, vagy hiányzik belőle egy fájl (kit_manifest_unreadable). Frissítsd a Marveent."
{
  IFS= read -r ROOT
  IFS= read -r MNODE
  IFS= read -r NODEMIN
  IFS= read -r RHASH
} <<EOF_PARSED
$PARSED
EOF_PARSED
[ -n "$ROOT" ] && [ -n "$MNODE" ] && [ -n "$NODEMIN" ] && [ -n "$RHASH" ] || stop "A készlet jegyzéke nem a várt alakú (kit_manifest_unreadable)."

# --- the node (3.2; N19): the manifest's first, then fixed places, the caller's PATH last ---
NODE=
for c in "$MNODE" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
  if [ -f "$c" ] && [ -x "$c" ]; then NODE=$c; break; fi
done
if [ -z "$NODE" ]; then
  c=$(PATH=$CALLER_PATH command -v node 2>/dev/null) || c=
  if [ -n "$c" ] && [ -f "$c" ] && [ -x "$c" ]; then NODE=$c; fi
fi
[ -n "$NODE" ] || stop "A Marveen futtatókörnyezete (Node.js) ezen a gépen nem található. Így a távoli segítség most nem kapcsolható be. Két lehetőséged van: (1) futtasd újra a Marveen telepítőjét; (2) írj nekünk, és lépésenként megmondjuk, mit tegyél."
if [ "$NODE" != "$MNODE" ]; then
  # Resolved ONCE to its absolute path (links too), then only that path is used.
  ABS=$(env -i PATH=@@RUN_PATH@@ LC_ALL=C "$NODE" -e 'process.stdout.write(process.execPath)' 2>/dev/null) || ABS=
  case "$ABS" in
    /*) case "$ABS" in *[!A-Za-z0-9._@/-]*) ABS= ;; esac ;;
    *) ABS= ;;
  esac
  [ -n "$ABS" ] || stop "A talált Node.js útja nem olvasható ki; így nem futtatom (node_unusable)."
  NODE=$ABS
  NOTE_NODE=1
fi
VER=$(env -i PATH=@@RUN_PATH@@ LC_ALL=C "$NODE" --version 2>/dev/null) || VER=
MAJOR=${VER#v}
MAJOR=${MAJOR%%.*}
case "$MAJOR" in
  ''|*[!0-9]*) stop "A Marveen futtatókörnyezete (Node.js) ezen a gépen nem indul (talált: ${VER:-nincs}, kell: legalább $NODEMIN). Futtasd újra a Marveen telepítőjét, vagy írj nekünk." ;;
esac
[ "$MAJOR" -ge "$NODEMIN" ] || stop "A Marveen futtatókörnyezete (Node.js) túl régi (talált: $VER, kell: legalább $NODEMIN). Futtasd újra a Marveen telepítőjét, vagy írj nekünk."
[ -z "${NOTE_NODE:-}" ] || printf '%s\n' "A Marveen saját Node.js-e nem található; ezt használom: $NODE ($VER)."

# --- one run of the KIT's routine through the loader (stdin: the caller's) ---
run_kit() {
  env -i PATH=@@RUN_PATH@@ LC_ALL=C "$NODE" --input-type=module -e '@@KIT_LOADER_SOURCE@@' -- "$RHASH" "$KIT/@@ROUTINE@@" "$@"
}

# --- one run of the INSTALL TREE's routine (disable only; N14/a) ---
run_tree() {
  env -i PATH=@@RUN_PATH@@ LC_ALL=C "$NODE" "$ROOT/@@TREE_ROUTINE@@" "$@"
}

# The answer of a run: exit 0 with no output is a failure; the loader's own codes are failures.
judge() {
  rc=$1; out=$2; what=$3
  case "$rc" in
    0) [ -n "$out" ] || stop "$what: a rutin nem válaszolt (kit_no_output)." ;;
    @@LOADER_MISMATCH@@) stop "$what: a készlet rutinja nem az a fájl, amit a jegyzék megnevez (kit_mismatch). Frissítsd a Marveent." ;;
    @@LOADER_USAGE@@|@@LOADER_UNREADABLE@@|@@LOADER_FAILED@@) stop "$what: a rutin nem indult el (kit_run_failed, $rc)." ;;
  esac
}

if [ "$MODE" = disable ]; then
  if [ -L "$ROOT/@@TREE_ROUTINE@@" ] || [ ! -f "$ROOT/@@TREE_ROUTINE@@" ]; then
    stop "A Marveen telepítésében a support-rutin hiányzik; a levétel így nem megy. Lépj be a marveen.io Profil oldalára, és ott zárd le a hozzáférést."
  fi
  OUT=$(run_tree disable </dev/null); rc=$?
  case "$rc" in
    0) [ -n "$OUT" ] || stop "A levétel nem válaszolt; nem tudom, sikerült-e. Lépj be a marveen.io Profil oldalára, és ott zárd le a hozzáférést." ;;
    2) stop "Ez a Marveen-kiadás még nem tudja helyben levenni a support-hozzáférést. Lépj be a marveen.io Profil oldalára, és ott zárd le." ;;
    *) printf '%s\n' "$OUT"; stop "A levétel nem sikerült ($rc). Lépj be a marveen.io Profil oldalára, és ott zárd le a hozzáférést." ;;
  esac
  printf '%s\n' "$OUT"
  exit 0
fi

# --- status (always; writes nothing) ---
KV=$(run_kit verify-kit </dev/null); rc=$?
judge "$rc" "$KV" "A készlet ellenőrzése"
case "$rc" in
  0) ;;
  2) stop "Ez a Marveen-kiadás még nem tudja ellenőrizni a support-készletet. Frissítsd a Marveent." ;;
  *) stop "A készlet ellenőrzése nem sikerült ($rc)." ;;
esac
[ "$KV" = "kit=ok" ] || stop "A support-készlet nem az, amit a jegyzéke mond ($KV). Frissítsd a Marveent, utána futtasd újra ezt a sort."

ST=$(run_kit status </dev/null); rc=$?
judge "$rc" "$ST" "Az állapot lekérdezése"
[ "$rc" -eq 0 ] || stop "Az állapot lekérdezése nem sikerült ($rc)."
printf '%s\n' "$ST"

READY=yes
for want in node=ok pins=ok sshd=ok curl=present; do
  case "
$ST
" in
    *"
$want
"*) ;;
    *) READY=no ;;
  esac
done
if [ "$READY" != yes ]; then
  stop "A gép most nem áll készen a távoli segítségre (a fenti sorok közül valamelyik nem rendben)."
fi

if [ "$MODE" = status ]; then
  printf '%s\n' "Minden rendben: a távoli segítség bekapcsolható. A kódot a következő lépésben kérem: futtasd így: ~/@@SUPPORT_DIR@@/@@KIT_DIR@@/@@LAUNCHER@@ enable"
  exit 0
fi

# --- enable: the one-time code, typed by the owner, to the routine on standard input ---
printf '%s' "Írd be a marveen.io Profil oldalán kapott egyszeri kódot, és nyomj Entert: "
IFS= read -r CODE || stop "Nem kaptam kódot."
case "$CODE" in
  @@CODE_GLOB@@) ;;
  *) stop "Ez nem a várt alakú kód. Másold be pontosan, ahogy a Profil oldal mutatja." ;;
esac
OUT=$(printf '%s\n' "$CODE" | run_kit enable); rc=$?
CODE=
case "$rc" in
  0) [ -n "$OUT" ] || stop "A bekapcsolás nem válaszolt (kit_no_output)." ;;
  2) stop "Ez a Marveen-kiadás még nem tudja bekapcsolni a távoli segítséget. Frissítsd a Marveent." ;;
  *) judge "$rc" "$OUT" "A bekapcsolás"; printf '%s\n' "$OUT"; stop "A bekapcsolás nem sikerült ($rc)." ;;
esac
printf '%s\n' "$OUT"
exit 0
