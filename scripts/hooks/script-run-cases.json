{
  "_comment": "JSCDSEND1104 (Samu 69478): the shared SCRIPT-RUN contract of the two mail gates: outgoing-copy-gate.py :: script_run_sends (the main agent's approval gate) and email-send-gate.mjs :: scriptRunSends (the sub-agents' send gate). The conformance test (script-run-conformance.test.ts) writes `files` into a fresh directory, runs EVERY case from that directory through BOTH implementations and asserts both equal `expected`, so a divergence between the two copies is a test failure. The JS twin did not follow a `cd` before the run and did not call a missing script a send; both are pinned here. Script contents are fixtures, nothing is executed.",
  "files": {
    "send.py": "import smtplib\nsmtplib.SMTP('x').sendmail('a', ['b'], 'c')\n",
    "plain.py": "print('x')\n",
    "main.py": "import helper_mail\nhelper_mail.go()\n",
    "helper_mail.py": "import smtplib\ndef go():\n    smtplib.SMTP('x')\n",
    "evil/send.py": "import smtplib\nsmtplib.SMTP('x').sendmail('a', ['b'], 'c')\n",
    "evil/plain.py": "import smtplib\nsmtplib.SMTP('x')\n",
    "evil/pkg/__init__.py": "",
    "evil/pkg/main.py": "import smtplib\nsmtplib.SMTP('x')\n",
    "pkgsend/__main__.py": "import smtplib\nsmtplib.SMTP('x')\n",
    "pkgclean/__main__.py": "print('x')\n",
    "nm.mjs": "const nodemailer = require('nodemailer')\n",
    "plain.mjs": "console.log(1)\n",
    "sender": "#!/usr/bin/env python3\nimport smtplib\nsmtplib.SMTP('x')\n",
    "harmless": "#!/usr/bin/env python3\nprint('x')\n",
    "p_sender": "#!/usr/bin/env -P /usr/bin python3\nimport smtplib\nsmtplib.SMTP('x')\n"
  },
  "executable": ["sender", "harmless", "p_sender"],
  "cases": [
    {"name": "a script that imports smtplib", "cmd": "python3 send.py", "expected": true},
    {"name": "control: a script that does not send", "cmd": "python3 plain.py", "expected": false},
    {"name": "a local helper sends", "cmd": "python3 main.py", "expected": true},
    {"name": "a cd before the run: the script there", "cmd": "cd evil && python3 send.py", "expected": true},
    {"name": "a cd in another segment", "cmd": "cd evil; python3 send.py", "expected": true},
    {"name": "cd -- DIR", "cmd": "cd -- evil && python3 send.py", "expected": true},
    {"name": "cd -P DIR", "cmd": "cd -P evil && python3 send.py", "expected": true},
    {"name": "an undecidable cd", "cmd": "cd $DEST && python3 plain.py", "expected": true},
    {"name": "control: a cd into the cwd itself", "cmd": "cd . && python3 plain.py", "expected": false},
    {"name": "a missing script is a send", "cmd": "python3 missing.py", "expected": true},
    {"name": "an undecidable script path", "cmd": "python3 $S", "expected": true},
    {"name": "control: python -m an installed module", "cmd": "python3 -m pytest", "expected": false},
    {"name": "python -m a local module after a cd", "cmd": "cd evil && python3 -m pkg.main", "expected": true},
    {"name": "python -m after an undecidable cd", "cmd": "cd $DEST && python3 -m pkg.main", "expected": true},
    {"name": "a directory whose __main__.py sends", "cmd": "python3 pkgsend", "expected": true},
    {"name": "control: a directory whose __main__.py does not send", "cmd": "python3 pkgclean", "expected": false},
    {"name": "node requiring nodemailer", "cmd": "node nm.mjs", "expected": true},
    {"name": "control: a harmless node script", "cmd": "node plain.mjs", "expected": false},
    {"name": "a directly executed file with a python #! line", "cmd": "./sender", "expected": true},
    {"name": "control: the same #! line on a harmless file", "cmd": "./harmless", "expected": false},
    {"name": "a #! env -P DIR python3 line", "cmd": "./p_sender", "expected": true},
    {"name": "a directly executed file after a cd", "cmd": "cd evil && ./send.py", "expected": true},
    {"name": "env -C DIR", "cmd": "env -C evil python3 send.py", "expected": true},
    {"name": "env -C with an undecidable DIR", "cmd": "env -C $X python3 plain.py", "expected": true},
    {"name": "sudo -D DIR (sudo's chdir, the same class)", "cmd": "sudo -D evil python3 send.py", "expected": true},
    {"name": "sudo --chdir=DIR", "cmd": "sudo --chdir=evil python3 plain.py", "expected": true},
    {"name": "sudo -u USER --chd DIR (a unique prefix)", "cmd": "sudo -u bob --chd evil python3 plain.py", "expected": true},
    {"name": "env -a ARG --c=DIR", "cmd": "env -a x --c=evil python3 plain.py", "expected": true},
    {"name": "a cd and env -C . after it", "cmd": "cd evil && env -C . python3 plain.py", "expected": true},
    {"name": "env -P DIR", "cmd": "env -P /tmp/x python3 send.py", "expected": true},
    {"name": "env -S STRING", "cmd": "env -S \"python3 send.py\"", "expected": true},
    {"name": "stdbuf in front", "cmd": "stdbuf -o0 python3 send.py", "expected": true},
    {"name": "a shell -c string with a cd", "cmd": "bash -c \"cd evil && python3 send.py\"", "expected": true},
    {"name": "a cd before a shell -c string (a harmless plain.py in the cwd, a sender of that name in evil)", "cmd": "cd evil && bash -c \"python3 plain.py\"", "expected": true},
    {"name": "an address after --to", "cmd": "python3 plain.py --to a@example.invalid", "expected": true},
    {"name": "control: bun test", "cmd": "bun test", "expected": false},
    {"name": "control: node --version", "cmd": "node --version", "expected": false},
    {"name": "control: a cd and a non-script run", "cmd": "cd evil && ls -la", "expected": false}
  ]
}
