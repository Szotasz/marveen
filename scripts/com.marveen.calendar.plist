<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Refreshes the calendar snapshot the morning briefing reads.

  This agent exists ONLY because of macOS TCC: the main agent runs under a
  long-lived tmux server, and the calendar permission is bound to that
  responsible process, not to the claude binary. A LaunchAgent gets its own
  identity and a GUI session, so it can both hold the grant and show the
  consent dialog. Restarting the main agent cannot substitute for this.

  Install:
    cp scripts/com.marveen.calendar.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.marveen.calendar.plist
    launchctl kickstart -k gui/$(id -u)/com.marveen.calendar    # first run: consent dialog appears

  RunAtLoad is false on purpose: the first run raises a permission dialog, and
  that should happen when the operator is watching, not at an arbitrary login.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marveen.calendar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ceo/Marveen/scripts/calendar-refresh.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ceo/Marveen</string>
  <key>RunAtLoad</key>
  <false/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/ceo/Marveen/store/calendar.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ceo/Marveen/store/calendar.error.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin</string>
    <key>HOME</key>
    <string>/Users/ceo</string>
  </dict>
</dict>
</plist>
