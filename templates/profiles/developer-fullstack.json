{
  "id": "developer-fullstack",
  "label": "Fejlesztő (full-stack, bővített sandbox)",
  "description": "Bővített sandbox full-stack mérnöknek (pl. Bit). A developer-junior szigorú homokozó bázisa: csak a saját munkakönyvtárába ír, kulcsok (SSH/AWS/GnuPG) elrejtve, main/master push és force-push tiltva, sudo tiltva. DE a parancslista ki van bővítve a valódi full-stack munkához (php, composer, mysql, node/npm/npx/yarn/pnpm, python/pip/pytest, docker, make, shell utilok). A production/deploy csatornák (ssh/scp/rsync/ftp) tiltva -- azok a jóváhagyás-kapun mennek át.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(/tmp/**)",
      "Write(/tmp/**)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(tsc:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pytest:*)",
      "Bash(php:*)",
      "Bash(composer:*)",
      "Bash(mysql:*)",
      "Bash(mysqldump:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(make:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(touch:*)",
      "Bash(rm:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(chmod:*)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash(which:*)",
      "Bash(env:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf ${HOME}:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ftp:*)",
      "Bash(sftp:*)",
      "Bash(lftp:*)"
    ]
  }
}
