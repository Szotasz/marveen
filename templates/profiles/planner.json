{
  "id": "planner",
  "label": "Tervező (olvas, nem ír)",
  "description": "Terv- és architektúra-készítéshez: OLVASHATJA a projekt repókat és a webet, de a repóba nem írhat. A researcher profil erre nem jó, mert az csak a saját agent-mappáját engedi olvasni, és a blanket curl-tiltása még az inter-agent jelentést is blokkolja. Következmény a workflow-ra: a tervező a terv-dokumentumot NEM tudja a repóba írni -- ${AGENT_DIR} vagy /tmp alá ír, és az orchestrator másolja be és commitolja.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(${HOME}/projects/**)",
      "Read(/tmp/**)",
      "Write(/tmp/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(curl:*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Write(${HOME}/projects/**)",
      "Edit(${HOME}/projects/**)",
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Read(${HOME}/.vault/**)",
      "Read(${HOME}/.secrets/**)",
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)"
    ]
  }
}
