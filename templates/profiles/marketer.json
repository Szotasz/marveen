{
  "id": "marketer",
  "label": "Marketinges",
  "description": "Email-vázlat, hírlevél, social tartalom. Mivel webes tartalmat olvas (prompt injection felület), szigorúan korlátozott: csak a saját mappájába írhat, SSH/AWS/.env tiltva, semmilyen Bash-pusztító parancs.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(${HOME}/Downloads/**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(mkdir:*)",
      "Bash(python3:*)",
      "Bash(curl:*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Read(${HOME}/.env)",
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(launchctl:*)",
      "Bash(crontab:*)",
      "Bash(osascript:*)"
    ]
  }
}
